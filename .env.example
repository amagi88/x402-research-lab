# Future exercise configuration; not loaded by the scaffold yet.
X402_NETWORK=eip155:84532
FACILITATOR_URL=https://x402.org/facilitator
PAY_TO_ADDRESS=
# Testnet-only private key: configure locally when implementing the buyer.
BUYER_PRIVATE_KEY=
# Public RPC example (not an automatic fallback): https://sepolia.base.org
MAX_PAYMENT_ATOMIC=10000

# Alchemy Base Sepolia Node API: replace <API_KEY> locally; never commit the real URL.
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<API_KEY>

# Structured JSON logs: debug | info | warn | error
LOG_LEVEL=info
SERVICE_NAME=x402-research-lab
PORT=4021
HOST=0.0.0.0
# Comma-separated trusted proxy IPs/CIDRs. Empty ignores X-Forwarded-For.
# On AWS, restrict to the actual load balancer subnets and restrict inbound traffic to it.
TRUST_PROXY=
# Hostnames only; add the deployed API hostname when running behind a load balancer.
# Empty retains the SDK's localhost protection.
MCP_ALLOWED_HOSTS=
